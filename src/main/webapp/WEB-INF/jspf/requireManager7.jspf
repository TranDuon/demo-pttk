<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="model.Manager7,view.Web7"%>
<%-- THUỘC TÍNH ẨN: session manager. Chặn truy cập nếu chưa xác thực quản lí. --%>
<%
    response.setHeader("Cache-Control", "no-store");
    Manager7 manager = (Manager7) session.getAttribute("manager");
    if (manager == null) {
        response.sendRedirect("../member/loginView7.jsp");
        return;
    }
%>
